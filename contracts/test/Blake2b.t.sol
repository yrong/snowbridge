pragma solidity 0.8.34;

import {Test} from "forge-std/Test.sol";
import {Blake2b} from "../src/utils/Blake2b.sol";

/// Vectors are `hashlib.blake2b(data, digest_size=32)` — what Substrate's `BlakeTwo256` computes.
contract Blake2bTest is Test {
    function test_empty() public view {
        assertEq(
            Blake2b.hash(""), 0x0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8
        );
    }

    function test_abc() public view {
        assertEq(
            Blake2b.hash("abc"), 0xbddd813c634239723171ef3fee98579b94964e3bb1cb3e427262c8c068d52319
        );
    }

    /// One byte short of a block: a single partial block with masked tail.
    function test_127_bytes() public view {
        assertEq(
            Blake2b.hash(sequence(127)),
            bytes32(0xf2fe67ff342e21b8f45e8f2e0bcd1d9243245d50ee6c78042e9c491388791c72)
        );
    }

    /// Exactly one block: full and final at once — no extra padding block.
    function test_128_bytes() public view {
        assertEq(
            Blake2b.hash(sequence(128)),
            bytes32(0xc3582f71ebb2be66fa5dd750f80baae97554f3b015663c8be377cfcb2488c1d1)
        );
    }

    /// One byte over: a full block, then a one-byte final block; `t` must carry across.
    function test_129_bytes() public view {
        bytes memory data = abi.encodePacked(sequence(128), bytes1(0x80));
        assertEq(
            Blake2b.hash(data), 0xf7f3c46ba2564ff4c4c162da1f5b605f9f1c4aa6a20652a9f9a337c1a2f5b9c9
        );
    }

    /// A header-sized input (three blocks, unaligned tail).
    function test_300_bytes() public view {
        bytes memory data =
            hex"";
        assertEq(data.length, 300);
        assertEq(
            Blake2b.hash(data), 0xe61e8ac5518bd6d6af82ef5c69f64c111c808b4ac72fe88e4850b1b1118d09fa
        );
    }

    /// Eight full blocks, exactly aligned.
    function test_1024_bytes() public view {
        assertEq(
            Blake2b.hash(sequence(1024)),
            bytes32(0xf1551feeb252c7e60bb362205bd1ac2f70b145260a91d41e8c5d0a187549a5f2)
        );
    }

    /// Every length from 0 to 300 against precomputed vectors, so block boundaries, the tail mask
    /// and the counter are exercised at every alignment. Data is `sequence(n)`; vectors are
    /// `hashlib.blake2b(bytes(i % 256 for i in range(n)), digest_size=32)`.
    function test_all_lengths_to_300() public view {
        for (uint256 n = 0; n <= 300; n++) {
            assertEq(Blake2b.hash(sequence(n)), VECTORS[n], string.concat("len=", vm.toString(n)));
        }
    }

    /// Gas of a header-sized hash, for the walk's per-hop budget.
    function test_gas_header_sized() public view {
        bytes memory data = pseudoRandom(300, 1);
        uint256 before = gasleft();
        Blake2b.hash(data);
        uint256 used = before - gasleft();
        assertLt(used, 20_000, "header-sized blake2b should stay well under 20k gas");
    }

    // ---- helpers ----

    function sequence(uint256 n) internal pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i = 0; i < n; i++) {
            out[i] = bytes1(uint8(i % 256));
        }
    }

    function pseudoRandom(uint256 n, uint256 seed) internal pure returns (bytes memory out) {
        out = new bytes(n);
        bytes32 acc = keccak256(abi.encode(seed));
        for (uint256 i = 0; i < n; i++) {
            if (i % 32 == 0) acc = keccak256(abi.encode(acc, i));
            out[i] = acc[i % 32];
        }
    }

